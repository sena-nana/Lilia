# =============================================================================
# Lilia · root .gitignore
# =============================================================================

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- 编辑器 / IDE ----------
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.vs/
*.swp
*.swo
*~
*.bak

# ---------- 日志 ----------
*.log
logs/

# ---------- 环境变量 / 机密 ----------
.env
.env.*
!.env.example
*.pem
*.key
.secrets/

# ---------- 禁止再引入的 Node / 前端产物（安全网） ----------
node_modules/
**/node_modules/
.npm/
.yarn/
.pnp.*
.cache/
.vite/
dist/
**/dist/
*.local

# ---------- Android / Gradle ----------
.gradle/
**/.gradle/
**/build/
**/local.properties
captures/

# ---------- 测试 / 覆盖率 ----------
coverage/
*.lcov
agent-debug-runs/
artifacts/native-preview-smoke/

# ---------- Rust / Cargo ----------
target/
**/target/
**/*.rs.bk
*.pdb

# ---------- 数据库 ----------
*.sqlite
*.sqlite3
*.db

# ---------- AI / Agent 副产物 ----------
.claude/
.claude-flow/
.mcp.json
CLAUDE.md

# ---------- 临时 ----------
tmp/
temp/
*.tmp
*.pid
