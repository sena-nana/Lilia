{
  "name": "@lilia/vscode-extension",
  "displayName": "Lilia AgentKit Compat",
  "description": "Minimal VS Code compat client for AgentKit Completion / Next Edit (#40). Does not require LiliaCore.",
  "version": "0.1.0",
  "private": true,
  "publisher": "lilia",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=26.0.0 <27"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.mjs",
  "peerDependencies": {
    "vscode": "^1.96.0"
  },
  "peerDependenciesMeta": {
    "vscode": {
      "optional": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "lilia.agentkit.status",
        "title": "Lilia: AgentKit Host Status"
      },
      {
        "command": "lilia.agentkit.nextEdit",
        "title": "Lilia: Plan Next Edit (AgentKit)"
      }
    ],
    "configuration": {
      "title": "Lilia AgentKit Compat",
      "properties": {
        "lilia.agentkit.hostMode": {
          "type": "string",
          "enum": [
            "process"
          ],
          "default": "process",
          "description": "Run the standalone AgentKit editor host"
        },
        "lilia.agentkit.hostBinary": {
          "type": "string",
          "default": "lilia-editor-compat",
          "description": "AgentKit editor host executable name or absolute path"
        }
      }
    }
  },
  "scripts": {
    "test": "node tests/hostClient.test.mjs && node tests/extensionBehavior.test.mjs"
  }
}
